# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected by AI Studio with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT="3000"

# DISCORD OAUTH2 (Optional - for Connect Discord Account feature)
# Create an app at https://discord.com/developers/applications
# Add Redirect URI: <APP_URL>/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# WEBRTC TWILIO NETWORK TRAVERSAL SERVICE (NTS)
# Backend-only credentials used to issue ephemeral TURN/STUN tokens dynamically.
# Public Google STUN fallback is used automatically if unset or unreachable.
TWILIO_ACCOUNT_SID=""
TWILIO_API_KEY=""
TWILIO_API_SECRET=""

# CLOUDINARY MEDIA STORAGE (Backend-only secrets for signed uploads & deletions)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# FIREBASE ADMIN SERVICE ACCOUNT (Optional JSON string for privileged server jobs)
FIREBASE_SERVICE_ACCOUNT_JSON=""
