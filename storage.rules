rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isSafeMedia() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|jpg|webp|gif)');
    }

    match /users/{userId}/avatars/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId && isSafeMedia();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/banners/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isSafeMedia();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /media/{conversationId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isSignedIn() && isSafeMedia();
      allow delete: if isSignedIn();
    }

    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId && isSafeMedia();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /banners/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isSafeMedia();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /servers/{serverId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isSignedIn() && isSafeMedia();
      allow delete: if isSignedIn();
    }

    match /attachments/{scopeId}/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isSafeMedia();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
