      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uploaderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "url": { "type": "string", "maxLength": 2048 },
        "cloudinaryPublicId": { "type": "string", "maxLength": 256 },
        "cloudinaryAssetId": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["general", "anime", "reactions", "funny", "flirty", "community"] },
        "visibility": { "type": "string", "enum": ["public", "private"] },
        "isAfterDark": { "type": "boolean" },
        "mimeType": { "type": "string", "maxLength": 64 },
        "sizeBytes": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "format": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uploaderId", "title", "url", "category", "visibility", "isAfterDark", "mimeType", "sizeBytes", "createdAt"]
    }
  },
