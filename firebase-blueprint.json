    "UserPublic": {
      "title": "UserPublic",
      "description": "Public non-PII profile representation for ShadowSpace users",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-z0-9_\\.]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "bio": { "type": "string", "maxLength": 500 },
        "pronouns": { "type": "string", "maxLength": 40 },
        "location": { "type": "string", "maxLength": 80 },
        "website": { "type": "string", "maxLength": 256 },
        "statusMessage": { "type": "string", "maxLength": 120 },
        "onlineStatus": { "type": "string", "enum": ["online", "idle", "dnd", "offline"] },
        "avatarUrl": { "type": "string", "maxLength": 2048 },
        "avatarPublicId": { "type": "string", "maxLength": 256 },
        "bannerUrl": { "type": "string", "maxLength": 2048 },
        "bannerPublicId": { "type": "string", "maxLength": 256 },
        "accentColor": { "type": "string", "maxLength": 32 },
        "profileBg": { "type": "string", "maxLength": 64 },
        "profileVisibility": { "type": "string", "enum": ["public", "friends", "private"] },
        "badges": { "type": "array" },
        "discordUsername": { "type": "string", "maxLength": 64 },
        "discordAvatar": { "type": "string", "maxLength": 2048 },
        "lastUsernameChange": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "displayName", "onlineStatus", "profileVisibility", "createdAt", "updatedAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private PII and sensitive account preferences stored under split collection",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "ageVerified": { "type": "boolean" },
        "afterDarkConsent": { "type": "boolean" },
        "dmPermission": { "type": "string", "enum": ["everyone", "friends", "server_members"] },
        "friendRequestPermission": { "type": "string", "enum": ["everyone", "mutual_servers", "none"] },
        "discordId": { "type": "string", "maxLength": 64 },
        "suspended": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "ageVerified", "afterDarkConsent", "suspended", "createdAt", "updatedAt"]
    },
    "UsernameClaim": {
      "title": "UsernameClaim",
      "description": "Unique lowercase username reservation",
      "type": "object",
